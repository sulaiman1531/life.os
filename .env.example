# AI Life OS - Backend Environment Configuration
# ================================================
# Copy this file to .env and fill in your keys.

# -----------------------------------------------
# GEMINI API KEY (for real LLM integration)
# Get yours at: https://aistudio.google.com/app/apikey
# -----------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------
# DATABASE (defaults to SQLite for local dev)
# For production, use a PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@localhost/lifeos
# -----------------------------------------------
# DATABASE_URL=sqlite:///./lifeos.db

# -----------------------------------------------
# AUTH SECRET (used for JWT signing in production)
# -----------------------------------------------
# SECRET_KEY=change_this_to_a_random_long_secret_string
